# Авторизация в myclass.team (api.klassno.app)
KLASSNO_LOGIN=
KLASSNO_PASSWORD=

# ID чатов для отслеживания через запятую (например: 28755 или 28755,161441)
# Если указать "all" — будут отслеживаться все доступные чаты
KLASSNO_THREAD_IDS=

# Интервал проверки новых сообщений в секундах
POLL_INTERVAL_SECONDS=15

# Пересылать ли свои собственные сообщения из чата
FORWARD_OWN_MESSAGES=false

# Telegram Bot настройки
# Токен бота от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# ID вашей Telegram беседы или лички (для групп обычно начинается с -100...)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Telegram ID администраторов через запятую для управления вайтлистом
TELEGRAM_ADMIN_IDS=

# Уровень логирования (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO

